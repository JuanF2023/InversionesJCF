{
  "watch": [
    "src"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "src/uploads",
    "src/**/*.test.js"
  ],
  "delay": "200",
  "legacyWatch": true,
  "env": {
    "FORCE_COLOR": "1",
    "NODE_ENV": "development"
  },
  "exec": "node --enable-source-maps --env-file=.env src/index.js"
}