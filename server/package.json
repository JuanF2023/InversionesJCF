{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run kill-port && nodemon --config nodemon.json",
    "kill-port": "npx kill-port 4000",
    "dev:reset": "npm run kill-port && npm run dev",
    "start": "node src/index.js",
    "clean": "rimraf node_modules",
    "seed:catalogo": "node --env-file=.env src/modules/corporativo/infrastructure/mongoose/seeds/runSeeds.js"
  },
  "imports": {
    "#core/*": "./src/core/*",
    "#config/*": "./src/config/*",
    "#lib/*": "./src/lib/*",
    "#middlewares/*": "./src/middlewares/*",
    "#utils/*": "./src/utils/*",
    "#modules/*": "./src/modules/*",
    "#corporativo/*": "./src/modules/corporativo/*",
    "#restaurante/*": "./src/modules/restaurante/*"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "mongodb": "^6.8.0",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}